{
  "name": "@nestjs/observe",
  "version": "0.0.1",
  "description": "Nest - modern, fast, powerful node.js web framework (@observe)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "oxlint --type-aware src",
    "lint:fix": "oxlint --type-aware --fix src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:int": "vitest run --config vitest.int.config.ts",
    "prepack": "npm run build",
    "prepublish:next": "npm run build",
    "publish:next": "npm publish --access public --tag next",
    "prepublish:npm": "npm run build",
    "publish:npm": "npm publish --access public",
    "prerelease": "npm run build",
    "release": "release-it",
    "prepare": "husky install"
  },
  "license": "MIT",
  "dependencies": {
    "@jridgewell/trace-mapping": "0.3.25"
  },
  "peerDependencies": {
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/graphql": "^13.0.0",
    "@nestjs/microservices": "^11.0.0",
    "bullmq": "^5.0.0",
    "reflect-metadata": "^0.1.12 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/bullmq": {
      "optional": true
    },
    "@nestjs/graphql": {
      "optional": true
    },
    "@nestjs/microservices": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    }
  },
  "devDependencies": {
    "@apollo/server": "4.11.0",
    "@as-integrations/express5": "1.1.2",
    "@commitlint/cli": "18.6.0",
    "@commitlint/config-angular": "18.6.0",
    "@grpc/grpc-js": "1.11.3",
    "@grpc/proto-loader": "0.7.13",
    "@nestjs/apollo": "13.4.5",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/graphql": "13.4.5",
    "@nestjs/microservices": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/testing": "11.2.1",
    "@swc/core": "1.16.1",
    "@types/node": "22.20.1",
    "@types/supertest": "6.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "bullmq": "5.13.2",
    "graphql": "16.9.0",
    "husky": "9.0.10",
    "lint-staged": "15.2.2",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.2.5",
    "reflect-metadata": "0.2.2",
    "release-it": "17.0.3",
    "rimraf": "6.0.1",
    "rxjs": "7.8.1",
    "supertest": "7.0.0",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.11",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "**/*.{ts,json}": []
  },
  "type": "module"
}
